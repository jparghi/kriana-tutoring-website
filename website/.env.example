# Public website configuration (safe placeholders only)
NEXT_PUBLIC_API_URL=https://your-api.example.com

# Public Firebase web configuration
NEXT_PUBLIC_FIREBASE_API_KEY=replace-with-public-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:replace-me

# Enrollment flow: keep both sides in request-only mode
NEXT_PUBLIC_BOOKING_FLOW_MODE=request_only
BOOKING_FLOW_MODE=request_only
ENABLE_AUTOMATED_STRIPE_PAYMENTS=false

# Local emulators only. Never set this in a production environment.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Firebase Admin credentials used only by Netlify functions.
# Set either FIREBASE_SERVICE_ACCOUNT_JSON, or all three split variables below.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# Required: use at least 32 random characters. It HMACs Netlify's trusted
# client-IP value for request throttling; requests fail closed if it is absent.
ENROLLMENT_RATE_LIMIT_SALT=replace-with-at-least-32-random-characters

# $10 Young Engineers demo flow: ships disabled by default (fail closed).
# Both flags must be explicitly 'true' to accept demo registrations/payments.
ENABLE_DEMO_PAYMENTS=false
NEXT_PUBLIC_ENABLE_DEMO_PAYMENTS=false
# Required once ENABLE_DEMO_PAYMENTS=true: at least 32 random characters. It
# HMACs the normalized child/parent identity into a non-reversible eligibility
# key used to enforce one demo per child; requests fail closed if it is absent.
DEMO_ELIGIBILITY_KEY_SALT=replace-with-at-least-32-random-characters
# Stripe test-mode keys, only needed once ENABLE_DEMO_PAYMENTS=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional acknowledgements. Requests are still saved if SMTP delivery fails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=info@krianatutoring.com
